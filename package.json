{
  "name": "dsh-think-skin",
  "version": "1.0.1",
  "description": "Reskin the DSH thinking row: your own image, your own words, double random.",
  "type": "module",
  "license": "MIT",
  "author": "Jestions",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jestions-dev/dsh-think-skin.git"
  },
  "homepage": "https://github.com/Jestions-dev/dsh-think-skin",
  "bugs": {
    "url": "https://github.com/Jestions-dev/dsh-think-skin/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "thinking",
    "spinner"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.png"
  },
  "files": [
    "icon.png",
    "assets/icon.png",
    "assets/icon.gif",
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "tools/import-pack.py",
    "assets/cover.gif",
    "assets/compiled-128",
    "assets/ClaudeCode/verbs.json",
    "assets/ClaudeCode/placeholder.png",
    "assets/酒狐",
    "tools/compile-pack.py",
    "assets/texts",
    "tools/export-texts.py"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "check": "node --check index.js && node --check client.js"
  },
  "icon": "./icon.png"
}
